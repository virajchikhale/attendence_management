# Copy to .env and adjust. Used by docker-compose.yml.
# Outside Docker, set the same variables in the web server's environment;
# without them the app falls back to localhost / root / empty password.

# --- Web ---
APP_PORT=8080
APP_TIMEZONE=Asia/Kolkata

# --- Database ---
DB_NAME=student_management
DB_USER=attendance
DB_PASSWORD=attendance
DB_ROOT_PASSWORD=change-me-root

# --- Email (OTP, welcome and password-change mails) ---
# Default: the bundled Mailpit catcher, readable at http://localhost:8025
MAILPIT_PORT=8025
SMTP_HOST=mailpit
SMTP_PORT=1025
# tls | ssl | none
SMTP_SECURE=none
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@attendance.local
MAIL_FROM_NAME=Student Management

# Example for Gmail (use an App Password, never the account password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=tls
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-app-password
# MAIL_FROM=you@gmail.com
